# Copy to supabase/.env (config.toml env(...) values, local stack) and
# supabase/functions/.env (Edge Function secrets, `supabase functions serve --env-file`).
# Hosted projects: `supabase secrets set --env-file supabase/functions/.env --project-ref <ref>`
# (one file per project: iwant-usa-staging, iwant-usa-prod, iwant-india-staging, iwant-india-prod).
# Never commit the real files. Empty optional values = feature off / dry-run.

# --- Auth (config.toml; hosted projects: dashboard > Authentication) ---------------------------------
SUPABASE_AUTH_GOOGLE_CLIENT_ID=           # web client id,android client id,ios client id (comma separated)
SUPABASE_AUTH_GOOGLE_SECRET=
SUPABASE_AUTH_APPLE_CLIENT_ID=            # services id,com.calecute.iwant.usa,com.calecute.iwant.india
SUPABASE_AUTH_APPLE_SECRET=               # ES256 client-secret JWT (rotate every <= 6 months)
SUPABASE_AUTH_CAPTCHA_SECRET=             # Cloudflare Turnstile secret for GoTrue (web sign-in)
SUPABASE_AUTH_SMS_TWILIO_ACCOUNT_SID=
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=
SUPABASE_AUTH_SMS_TWILIO_VERIFY_SERVICE_SID=

# --- Injected automatically on hosted projects (set them only for local serve) -----------------
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Project identity ---------------------------------------------------------------------------
APP_COUNTRY=IN                            # IN | US (must match app_settings.country)
APP_DISPLAY_NAME=I Want India             # I Want USA / I Want India

# --- Database -> Edge Functions (pg_net, cron) ----------------------------------------------------
# Same value as the Vault secret `edge_webhook_secret` (see README "Database webhooks").
EDGE_WEBHOOK_SECRET=

# --- Rate limiting (optional; without it Edge rate limits are no-ops, DB limits still apply) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Firebase: FCM HTTP v1 + App Check -------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT=                 # service-account JSON (raw or base64) with "Firebase Cloud Messaging API Admin"
FIREBASE_PROJECT_ID=                      # optional, defaults to the service account's project_id
FIREBASE_PROJECT_NUMBER=                  # App Check audience / issuer
APP_CHECK_ENFORCE=false                   # true = reject calls without a valid X-Firebase-AppCheck token

# --- Sign in with Apple token revocation (delete-account) ------------------------------------
APPLE_TEAM_ID=
APPLE_SIGNIN_KEY_ID=
APPLE_SIGNIN_PRIVATE_KEY=                 # contents of the .p8 key ("\n" escapes allowed)
APPLE_SIGNIN_CLIENT_ID=com.calecute.iwant.india   # bundle id used by native sign-in

# --- App Store Server Notifications V2 (appstore-notifications) ----------------------------
APPLE_BUNDLE_ID=com.calecute.iwant.india
APPSTORE_ENVIRONMENT=                     # Production | Sandbox | empty = accept both
APPSTORE_ALLOW_UNVERIFIED_CHAIN=false     # staging only until the x5c chain check (TODO) is implemented

# --- Google Play (play-rtdn) ------------------------------------------------------------------
PLAY_PACKAGE_NAME=com.calecute.iwant.india
PLAY_SERVICE_ACCOUNT=                     # service-account JSON with Play Console financial + orders permissions
PLAY_RTDN_AUDIENCE=                       # Pub/Sub push OIDC audience (the function URL)
PLAY_RTDN_PUSH_SERVICE_ACCOUNT=           # Pub/Sub push service-account email

# --- Stripe (USA web checkout) ------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=                    # whsec_... of the stripe-webhook endpoint
STRIPE_AUTOMATIC_TAX=false
STRIPE_PRICE_SELLER_PRO_MONTHLY=          # price_...
STRIPE_PRICE_SELLER_PRO_ANNUAL=
STRIPE_PRICE_CREDITS_10=
STRIPE_PRICE_CREDITS_50=

# --- Razorpay (India web checkout) ------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_SELLER_PRO_MONTHLY=         # plan_...
RAZORPAY_PLAN_SELLER_PRO_ANNUAL=
RAZORPAY_AMOUNT_CREDITS_10=               # paise, e.g. 19900
RAZORPAY_AMOUNT_CREDITS_50=

# --- Checkout return URLs (create-checkout) -------------------------------------------------------
CHECKOUT_RETURN_BASE_URL=https://iwantindia.com/seller/billing
CHECKOUT_ALLOWED_ORIGINS=https://iwantindia.com,https://admin.iwantindia.com

# --- Seller outreach (Section 21; outreach-send, outreach-webhook, import-leads, brochure-link) ----
OUTREACH_PROVIDER=dry_run                 # resend | ses | brevo | dry_run
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=                    # whsec_... (Svix) of the outreach-webhook endpoint
BREVO_API_KEY=
AWS_SES_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_CONFIGURATION_SET=
OUTREACH_SENDER_NAME=
OUTREACH_SENDER_ROLE=Founder
OUTREACH_COMPANY_NAME=                    # default: Calecute Technologies LLC / Calecute Technologies (OPC) Private Limited
OUTREACH_PHYSICAL_ADDRESS=                # required ({{US_BUSINESS_ADDRESS}} / Indian registered office)
OUTREACH_WEBSITE_URL=                     # required
OUTREACH_PRIVACY_URL=                     # required
OUTREACH_AD_NOTICE=                       # USA default: "This is a business offer from I Want USA."
OUTREACH_REPLY_TO=                        # real reply inbox on the outreach domain
OUTREACH_UNSUBSCRIBE_URL=                 # default: <SUPABASE_URL>/functions/v1/outreach-webhook
OUTREACH_UNSUBSCRIBE_MAILTO=              # optional mailto for List-Unsubscribe
OUTREACH_MAX_PER_RUN=8                    # per campaign per 10-minute cron run (pacing)
SELLER_SIGNUP_URL=https://iwantindia.com/sell
GOOGLE_PLACES_API_KEY=                    # import-leads source=places (hard budget in app_settings)
OVERPASS_URL=https://overpass-api.de/api/interpreter
LEAD_IMPORT_USER_AGENT=IWantLeadImport/1.0 (+contact: admin@iwantindia.com)

# --- Website forms (web-forms) ----------------------------------------------------------------
TURNSTILE_SECRET_KEY=                     # Cloudflare Turnstile secret for the sites' widget
TURNSTILE_ALLOWED_HOSTNAMES=iwantindia.com,www.iwantindia.com
WEB_FORMS_ALLOWED_ORIGINS=https://iwantindia.com,https://www.iwantindia.com
WEB_FORMS_RATE_LIMIT=5                    # submissions per IP per 10 minutes
WEB_FORMS_PUBLIC_URL=                     # default: <SUPABASE_URL>/functions/v1/web-forms (confirmation links)
IP_HASH_SALT=                             # random; IPs are stored only as salted hashes
WAITLIST_CONFIRMED_URL=                   # optional redirect after double opt-in
TRANSACTIONAL_EMAIL_PROVIDER=stub         # resend | brevo | ses | stub (main app domain, not the outreach one)
TRANSACTIONAL_FROM_EMAIL=                 # e.g. hello@iwantindia.com
TRANSACTIONAL_FROM_NAME=I Want India
