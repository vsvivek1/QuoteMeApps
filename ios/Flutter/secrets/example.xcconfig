// Copy to ios/Flutter/secrets/<flavor>.xcconfig (e.g. usaProd.xcconfig). Those files are gitignored.
// CI writes them from repository secrets. These ids are not secret, but they differ per flavor.
GOOGLE_IOS_CLIENT_ID = 000000000000-xxxxxxxx.apps.googleusercontent.com
GOOGLE_IOS_REVERSED_CLIENT_ID = com.googleusercontent.apps.000000000000-xxxxxxxx
GOOGLE_SERVER_CLIENT_ID = 000000000000-yyyyyyyy.apps.googleusercontent.com
