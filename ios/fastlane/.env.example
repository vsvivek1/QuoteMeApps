# Copy to ios/fastlane/.env (git-ignored) or set in CI secrets. Never commit real values.
# Every variable can be set per country with a _USA / _INDIA suffix; the unsuffixed
# name is used as a fallback. Full reference: fastlane/README.md

# --- App Store Connect API key (one per Apple developer team / legal entity) ---
ASC_KEY_ID_USA=
ASC_ISSUER_ID_USA=
ASC_KEY_PATH_USA=secrets/AuthKey_USA.p8        # or ASC_KEY_CONTENT_USA (base64 of the .p8) in CI
ASC_KEY_ID_INDIA=
ASC_ISSUER_ID_INDIA=
ASC_KEY_PATH_INDIA=secrets/AuthKey_INDIA.p8
# ASC_KEY_CONTENT_USA=
# ASC_KEY_CONTENT_INDIA=

# --- Apple team ---
APPLE_TEAM_ID_USA=
APPLE_TEAM_ID_INDIA=
# ASC_TEAM_ID_USA=            # only if the Apple ID belongs to several App Store Connect teams
# ASC_TEAM_ID_INDIA=

# --- match (code signing) ---
MATCH_GIT_URL_USA=git@github.com:calecute/certificates-iwant-usa.git
MATCH_GIT_URL_INDIA=git@github.com:calecute/certificates-iwant-india.git
# MATCH_GIT_BRANCH_USA=usa
# MATCH_GIT_BRANCH_INDIA=india
MATCH_PASSWORD=
# MATCH_GIT_BASIC_AUTHORIZATION=   # base64 "user:token" for HTTPS clones in CI
# MATCH_STORAGE_MODE=git           # or google_cloud / s3
MATCH_READONLY=true
# IOS_FORCE_MANUAL_SIGNING=true    # switch Release-<flavor> to the match profile locally (always on in CI)

# --- TestFlight ---
# TESTFLIGHT_GROUPS=Internal QA,Founding sellers

# --- Build ---
# DART_DEFINE_FILE_USA=config/usa.prod.json
# DART_DEFINE_FILE_INDIA=config/india.prod.json

# --- Store metadata placeholders substituted at upload time ---
WEB_DOMAIN_USA=
WEB_DOMAIN_INDIA=

# --- App Review contact and demo logins (prod Supabase test phone numbers + fixed OTPs) ---
REVIEW_CONTACT_FIRST_NAME_USA=
REVIEW_CONTACT_LAST_NAME_USA=
REVIEW_CONTACT_PHONE_USA=
REVIEW_CONTACT_EMAIL_USA=
REVIEW_BUYER_PHONE_USA=
REVIEW_BUYER_OTP_USA=
REVIEW_SELLER_PHONE_USA=
REVIEW_SELLER_OTP_USA=
REVIEW_CONTACT_FIRST_NAME_INDIA=
REVIEW_CONTACT_LAST_NAME_INDIA=
REVIEW_CONTACT_PHONE_INDIA=
REVIEW_CONTACT_EMAIL_INDIA=
REVIEW_BUYER_PHONE_INDIA=
REVIEW_BUYER_OTP_INDIA=
REVIEW_SELLER_PHONE_INDIA=
REVIEW_SELLER_OTP_INDIA=
