# Trends news site (separate domain). Everything here is PUBLIC; no secrets.
SITE_URL=                        # e.g. https://<TRENDS_DOMAIN> once registered (default placeholder https://trends-site.example)
SITE_NAME=                       # default "What's Happening" (working name)
EDITOR_NAME=                     # named editor responsible for the site
EDITOR_EMAIL=
TRENDS_DATA_DIR=data/articles    # one JSON file per article, written by the publishing pipeline
TRENDS_CONFIG=data/config.json   # caps, ramp level, gate thresholds, kill switch
APP_LINK_HOSTS=iwantusa.app,iwantindia.app
PUBLIC_TURNSTILE_SITE_KEY=       # Cloudflare Turnstile SITE key (public)
FORMS_ENDPOINT=                  # Supabase Edge Function URL for contact / error reports
NEWS_SITEMAP=0                   # 1 only once the site qualifies for Google News
BUILD_NOW=                       # optional ISO date to make builds reproducible in tests
