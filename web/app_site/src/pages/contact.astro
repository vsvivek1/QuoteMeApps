---
import Base from '../layouts/Base.astro';
import Form from '../components/Form.astro';
import { site } from '../lib/site';
---
<Base title="Contact us" description={`Contact ${site.appName} support (${site.company}).`} path="/contact">
  <div class="split">
  <div class="sticky">
  <div class="page-head">
    <h1>Contact us</h1>
  </div>
  <p class="lead">Questions, feedback, a problem with a seller or buyer, or a press enquiry? Send us a message and we will reply by email.</p>
  <p>For support hours, phone and postal address see <a href="/legal/contact-support">Contact and Support</a>.
    {site.country === 'india' && <> Complaints under the IT Rules 2021 go to our <a href="/legal/grievance-officer">Grievance Officer</a>.</>}
    To delete your account use the <a href="/legal/account-deletion">account deletion page</a>.</p>
  </div>
  <div class="panel form-panel">
  <Form kind="contact" submitLabel="Send message" successMessage="Thanks, your message has been sent. We usually reply within 2 working days.">
    <label>Your name<input name="name" required maxlength="80" autocomplete="name" /></label>
    <label>Email<input name="email" type="email" required maxlength="160" autocomplete="email" /></label>
    <label>Topic
      <select name="topic" required>
        <option value="">Choose one</option>
        <option value="buyer_help">Help with a request</option>
        <option value="seller_help">Help as a seller</option>
        <option value="report">Report a user or listing</option>
        <option value="price_page_error">Report an error on a price page</option>
        <option value="privacy">Privacy question</option>
        <option value="other">Something else</option>
      </select>
    </label>
    <label>Message<textarea name="message" required maxlength="4000"></textarea></label>
    <p class="small muted">We use your details only to answer you. See our <a href="/legal/privacy-policy">Privacy Policy</a>.</p>
  </Form>
  </div>
  </div>
</Base>
