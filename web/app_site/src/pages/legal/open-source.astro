---
import Base from '../../layouts/Base.astro';
import { site } from '../../lib/site';
import { townSources } from '../../lib/towns';
---
<Base title="Open-source licences" description={`Open-source software used by ${site.appName}.`} path="/legal/open-source">
  <div class="prose">
    <p class="breadcrumbs"><a href="/legal">Legal</a> /</p>
    <h1>Open-source licences</h1>
    <p>{site.appName} is built with open-source software, including Flutter and Dart (BSD-3-Clause), Supabase client libraries (MIT) and this website's generator, Astro (MIT).</p>
    <p>The full list of licences for every package in the app is shown in the app under <strong>Settings &gt; Legal &gt; Open-source licences</strong>.</p>
    <h2 id="data">Data</h2>
    <p>
      Town pages and the town picker use place, district/county, population and postal-code data from
      <a href="https://www.geonames.org/" rel="noopener">GeoNames</a>, licensed under
      <a href="https://creativecommons.org/licenses/by/4.0/" rel="noopener">Creative Commons Attribution 4.0</a>.
      We changed it: places were matched to post offices and ZIP codes, and population is shown only as a rounded band.
      Maps on this site use <a href="https://www.openstreetmap.org/copyright" rel="noopener">OpenStreetMap</a> tiles (&copy; OpenStreetMap contributors).
    </p>
    <ul>
      {townSources.map((s) => <li>{s.title} ({s.licence})</li>)}
    </ul>
  </div>
</Base>
