---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Form from '../../components/Form.astro';
import { legalHtml, legalPages, type LegalEntry } from '../../lib/legal';
import { site } from '../../lib/site';

export const getStaticPaths = (async () =>
  (await legalPages()).map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }))) satisfies GetStaticPaths;

const { entry } = Astro.props as { entry: LegalEntry };
const html = legalHtml(entry);
const isDeletion = entry.data.slug === 'account-deletion';
const deletionConsent = `I confirm I want ${site.appName} to delete my account and understand this cannot be undone.`;
---
<Base title={entry.data.title} description={`${entry.data.title} for ${site.appName} (${site.company}). Version ${entry.data.version}.`} path={`/legal/${entry.data.slug}`}>
  <p class="breadcrumbs"><a href="/legal">Legal</a> /</p>
  <article class="prose" set:html={html} />
  {isDeletion && (
    <section class="prose panel form-panel" id="request-deletion">
      <h2>Request deletion without the app</h2>
      <p>Enter the email and/or phone number on your account (at least one). To protect you, we confirm the request by sending a one-time code to the phone number registered on the account before anything is deleted.</p>
      <Form kind="account_deletion" requireOne="email,phone" submitLabel="Request account deletion" successMessage="Request received. If the account has a phone number, enter the code we sent below; otherwise we will contact you to confirm it is you.">
        <label>Email used on your account (if any)<input name="email" type="email" maxlength="160" autocomplete="email" /></label>
        <label>Phone number registered on your account<input name="phone" type="tel" maxlength="20" autocomplete="tel" /></label>
        <label>Why are you leaving? (optional)<textarea name="reason" maxlength="1000"></textarea></label>
        <label class="check"><input type="checkbox" name="confirm_delete" value="yes" required data-consent={deletionConsent} /><span>{deletionConsent}</span></label>
      </Form>
    </section>
  )}
</Base>
