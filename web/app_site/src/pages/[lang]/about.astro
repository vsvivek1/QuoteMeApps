---
import type { GetStaticPaths } from 'astro';
import AboutPage from '../../components/pages/AboutPage.astro';
import { SECOND_LOCALE, localeBySegment } from '../../lib/i18n';

// Translated version (hi-IN on the India site, es-US on the USA site); see lib/i18n.ts.
export const getStaticPaths = (() => [{ params: { lang: SECOND_LOCALE.segment } }]) satisfies GetStaticPaths;
const locale = localeBySegment(Astro.params.lang);
---
<AboutPage locale={locale} />
