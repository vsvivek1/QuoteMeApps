---
import Base from '../layouts/Base.astro';
import StoreBadges from '../components/StoreBadges.astro';
import { abs, site } from '../lib/site';
import { cityHubs, loadSeo } from '../lib/seo';

const { data } = await loadSeo();
const hubs = (await cityHubs()).filter((h) => h.indexable).slice(0, 12);
const groups = [...new Set(data.categories.filter((c) => c.policy === 'allowed').map((c) => c.group))];
const description = `${site.appName}: post what you want and local and online sellers send you quotes. Compare prices side by side, chat, and pick the best offer. Free for buyers.`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: site.company,
    url: site.url,
    logo: abs('/brand/pwa_512.png'),
    brand: site.appName,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'MobileApplication',
    name: site.appName,
    operatingSystem: 'Android, iOS',
    applicationCategory: 'ShoppingApplication',
    offers: { '@type': 'Offer', price: '0', priceCurrency: site.currency },
    publisher: { '@type': 'Organization', name: site.company },
  },
];
---
<Base title={`${site.appName}: post what you want, get quotes from local sellers`} description={description} path="/" jsonLd={jsonLd} smartBanner>
  <section class="hero">
    <h1>Post what you want.<br />Local sellers send you quotes.</h1>
    <p class="lead">
      Stop calling ten shops. Tell {site.appName} what you need, and local and online firms compete to give you their best price.
      Compare quotes side by side, chat, and accept the one you like.
    </p>
    <StoreBadges campaign="home_hero" />
    <p class="muted small">Free for buyers. Your phone number is shared with a seller only after you accept their quote; before that you talk in the in-app chat.</p>
  </section>

  <section id="how-it-works">
    <h2>How it works</h2>
    <ol class="steps">
      <li><strong>Post a request in under a minute.</strong> For example: <em>"{site.exampleRequests[0]}"</em>. Add photos, your {site.postalLabel} and when you need it.</li>
      <li><strong>Get quotes from matching sellers.</strong> Only sellers who sell or service that category near you can quote, and each request is capped so you are not flooded.</li>
      <li><strong>Compare, chat and accept.</strong> See price, taxes, delivery time, warranty and ratings side by side. Pay the seller directly the way you agree.</li>
    </ol>
  </section>

  <section>
    <h2>What people ask for</h2>
    <div class="grid">
      {site.exampleRequests.map((r) => <div class="card"><p>"{r}"</p></div>)}
    </div>
    {groups.length > 0 && (
      <>
        <h3>Categories</h3>
        <ul class="chips">{groups.map((g) => <li><span>{g}</span></li>)}</ul>
      </>
    )}
  </section>

  {hubs.length > 0 && (
    <section>
      <h2>Local prices from real quotes</h2>
      <p>Median prices from quotes sent on {site.appName}, updated nightly.</p>
      <ul class="chips">{hubs.map((h) => <li><a href={`/quotes/${h.city.slug}`}>{h.city.name}</a></li>)}</ul>
    </section>
  )}

  <section>
    <h2>Run a shop or a service business?</h2>
    <div class="grid">
      <div class="card"><h3>Ready buyers, near you</h3><p>See requests from people who already know what they want, filtered by your categories and service area.</p></div>
      <div class="card"><h3>Quote in seconds</h3><p>Send a price with tax, delivery and warranty from your phone. Chat once the buyer is interested.</p></div>
      <div class="card"><h3>Verified and fair</h3><p>Get a Verified badge ({site.sellerIds}). Buyers rate sellers after each job, and any sponsored placement is clearly labelled.</p></div>
    </div>
    <div class="actions"><a class="btn" href="/sellers">Become a seller</a></div>
  </section>

  <section>
    <h2>Your data stays in {site.country === 'usa' ? 'the United States' : 'India'}</h2>
    <p>
      {site.appName} is run by {site.company}. Your account data is stored in a {site.country === 'usa' ? 'US' : 'Mumbai, India'} data centre and handled under {site.privacyLaw}.
      Read our <a href="/legal/privacy-policy">Privacy Policy</a>, or <a href="/legal/account-deletion">delete your account</a> at any time.
    </p>
  </section>
</Base>
