---
import '../styles/global.css';
import { abs, site } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** Path of this page (canonical), e.g. "/legal/privacy-policy". */
  path: string;
  canonical?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  jsonLd?: object[];
  smartBanner?: boolean;
}

const { title, description, path, canonical, noindex = false, ogType = 'website', jsonLd = [], smartBanner = false } = Astro.props;
const fullTitle = title.includes(site.appName) ? title : `${title} | ${site.appName}`;
const canonicalUrl = canonical ?? abs(path === '/' ? '/' : path);
const og = abs('/brand/og_image_1200x630.png');
const nav = [
  { href: '/#how-it-works', label: 'How it works' },
  { href: '/quotes', label: 'Local prices' },
  { href: '/sellers', label: 'For sellers' },
  { href: '/contact', label: 'Contact' },
];
const year = new Date().getFullYear();
---
<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content={site.country === 'usa' ? '#1D4ED8' : '#C2410C'} />
    <link rel="icon" href="/brand/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/brand/favicon_32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/brand/apple_touch_icon_180.png" />
    <link rel="stylesheet" href="/theme.css" />
    <meta property="og:site_name" content={site.appName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {smartBanner && site.ios.appId && <meta name="apple-itunes-app" content={`app-id=${site.ios.appId}`} />}
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d).replace(/</g, '\\u003c')} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a href="/" class="logo" aria-label={`${site.appName} home`}>
          <img src="/brand/logo_mark.svg" alt="" width="36" height="36" />
          <span>{site.appName}</span>
        </a>
        <nav aria-label="Main">
          <ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
        </nav>
      </div>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-inner">
        <div>
          <p class="footer-brand">{site.appName}</p>
          <p>Post what you want. Local and online sellers send you quotes.</p>
          <p class="muted">&copy; {year} {site.company}</p>
        </div>
        <nav aria-label="Company">
          <ul>
            <li><a href="/about">About</a></li>
            <li><a href="/editorial-policy">Editorial policy</a></li>
            <li><a href="/sellers">Become a seller</a></li>
            <li><a href="/waitlist">Join the waitlist</a></li>
            <li><a href="/contact">Contact</a></li>
          </ul>
        </nav>
        <nav aria-label="Legal">
          <ul>
            <li><a href="/legal/terms-of-service">Terms of Service</a></li>
            <li><a href="/legal/privacy-policy">Privacy Policy</a></li>
            {site.country === 'usa' && <li><a href="/legal/ccpa-notice">Do Not Sell or Share My Personal Information</a></li>}
            {site.country === 'india' && <li><a href="/legal/grievance-officer">Grievance Officer</a></li>}
            <li><a href="/legal/account-deletion">Delete your account</a></li>
            <li><a href="/legal">All legal pages</a></li>
          </ul>
        </nav>
      </div>
    </footer>
  </body>
</html>
