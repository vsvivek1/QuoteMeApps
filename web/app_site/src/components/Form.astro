---
import { formsEnabled, site, warnOnce } from '../lib/site';
import { LOCALES, richText, translator, type Locale } from '../lib/i18n';

interface Props {
  /** Sent as "form" to the Edge Function, which routes on it. */
  kind: 'seller_signup' | 'contact' | 'waitlist' | 'account_deletion';
  submitLabel: string;
  successMessage: string;
  /** Comma-separated field names of which at least one must be filled. */
  requireOne?: string;
  /** Language of the notices and status messages (default English). */
  locale?: Locale;
}
const { kind, submitLabel, successMessage, requireOne, locale = LOCALES[0] } = Astro.props;
const { t } = translator(locale);
// Status messages for scripts/forms.ts (no inline script, so the CSP stays strict).
const msgs = {
  'data-msg-require-one': t('form.requireOne'),
  'data-msg-spam': t('form.spamCheck'),
  'data-msg-sending': t('form.sending'),
  'data-msg-too-many': t('form.tooMany'),
  'data-msg-failed': t('form.failed'),
  'data-msg-network': t('form.network'),
};
if (!formsEnabled) {
  warnOnce('PUBLIC_TURNSTILE_SITE_KEY or FORMS_ENDPOINT unset: forms render disabled.');
}
---
{!formsEnabled && (
  <p class="notice warn">
    {t('form.off')}{' '}
    {site.supportEmail ? <Fragment set:html={richText(t('form.offEmail', { email: site.supportEmail }))} /> : t('form.offContact')}
  </p>
)}
<form
  class="form js-form"
  data-endpoint={site.formsEndpoint}
  data-kind={kind}
  data-country={site.country}
  data-success={successMessage}
  data-require-one={requireOne}
  {...msgs}
  novalidate
>
  <slot />
  <div class="hp" aria-hidden="true">
    <label>{t('form.honeypot')}<input type="text" name="website_url_confirm" tabindex="-1" autocomplete="off" /></label>
  </div>
  {formsEnabled && <div class="cf-turnstile" data-sitekey={site.turnstileSiteKey} data-action={kind}></div>}
  <noscript><p class="notice warn">{t('form.noscript')}</p></noscript>
  <div><button class="btn" type="submit" disabled={!formsEnabled}>{submitLabel}</button></div>
  <p class="form-status" role="status" aria-live="polite"></p>
</form>
{kind === 'account_deletion' && (
  <form class="form js-otp-step" data-endpoint={site.formsEndpoint} hidden novalidate>
    <p>If the account has a phone number, we just sent a 6-digit code to it. Enter it here to confirm the deletion. The code is valid for 15 minutes.</p>
    <label>Confirmation code<input name="otp" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" required /></label>
    <div><button class="btn" type="submit">Confirm deletion</button></div>
    <p class="form-status" role="status" aria-live="polite"></p>
  </form>
)}
{formsEnabled && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
<script>
  import '../scripts/forms';
</script>
