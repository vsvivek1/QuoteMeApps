---
// Home page body for every locale (pages/index.astro and pages/[lang]/index.astro).
import Base from '../../layouts/Base.astro';
import StoreBadges from '../StoreBadges.astro';
import { abs, money, site } from '../../lib/site';
import { cityHubs, loadSeo } from '../../lib/seo';
import { localePath, translator, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { t, raw, rich, fact } = translator(locale);
const href = (p: string) => localePath(locale, p);

const { data } = await loadSeo();
const hubs = (await cityHubs()).filter((h) => h.indexable).slice(0, 12);
const groups = [...new Set(data.categories.filter((c) => c.policy === 'allowed').map((c) => c.group))];
const examples = fact<string[]>('exampleRequests');
const [h1a, h1b] = raw<string[]>('home.h1');
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: site.company,
    url: site.url,
    logo: abs('/brand/pwa_512.png'),
    brand: site.appName,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'MobileApplication',
    name: site.appName,
    operatingSystem: 'Android, iOS',
    applicationCategory: 'ShoppingApplication',
    offers: { '@type': 'Offer', price: '0', priceCurrency: site.currency },
    publisher: { '@type': 'Organization', name: site.company },
    inLanguage: locale.hreflang,
  },
];
const campaign = locale.segment ? `home_hero_${locale.segment}` : 'home_hero';
// Illustrative quotes for the hero mock-up (decorative, aria-hidden): the first example request.
const mockQuotes = (site.country === 'india' ? [48990, 51200, 52450] : [2849, 2979, 3115]).map((n) => money(n));
const mockRatings = ['4.9', '4.7', '4.8'];
// "Your town: {name}" split around the name, which the town picker script fills in.
const [townBefore, townAfter = ''] = raw<string>('town.current').split('{name}');
const faq = raw<{ q: string }[]>('home.faq').map((_, i) => ({ q: t(`home.faq.${i}.q`), a: t(`home.faq.${i}.a`) }));
const sellIcons = [
  '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />',
  '<path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z" />',
  '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /><path d="m9 12 2 2 4-4" />',
];
const stepIcons = [
  '<path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z" />',
  '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />',
  '<path d="M20 6 9 17l-5-5" />',
];
const svg = (paths: string) =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths}</svg>`;
---
<Base title={t('home.title')} description={t('home.description')} path={href('/')} jsonLd={jsonLd} smartBanner wide>
  <section class="home-hero" aria-labelledby="hero-title">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">{t('home.og.kicker')}</p>
        <h1 id="hero-title">{h1a} <span class="accent">{h1b}</span></h1>
        <p class="lead">{t('home.lead')}</p>
        <div id="get-app">
          <StoreBadges campaign={campaign} locale={locale} />
        </div>
        <p class="free-note">
          <Fragment set:html={svg('<rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" />')} />
          <span>{t('home.freeNote')}</span>
        </p>
        <p class="town-note">
          <Fragment set:html={svg('<path d="M12 22s7-6.2 7-12a7 7 0 0 0-14 0c0 5.8 7 12 7 12z" /><circle cx="12" cy="10" r="2.5" />')} />
          <span data-town-default><a href="/in" data-town-open>{t('town.choose')}</a>: {t('town.homeNote')}</span>
          <span data-town-current hidden>{townBefore}<a href="/in" data-town-link>{t('town.short')}</a>{townAfter} · <a href="/in" data-town-open>{t('town.change')}</a></span>
        </p>
      </div>
      <div class="mock" aria-hidden="true">
        <div class="mock-phone">
          <div class="mock-request">
            <span class="mock-label">{t('home.mock.request')}</span>
            <p>{examples[0]}</p>
          </div>
          <div class="mock-count"><span class="mock-live">{t('home.mock.quotes', { n: mockQuotes.length })}</span><span>{t('home.mock.best')}</span></div>
          <ul class="mock-quotes">
            {mockQuotes.map((price, i) => (
              <li class={i === 0 ? 'mock-quote best' : 'mock-quote'}>
                <span class="mock-avatar">{String.fromCharCode(65 + i)}</span>
                <span class="mock-lines"><i></i><span class="mock-rating">★ {mockRatings[i]}</span></span>
                <span class="mock-price">{price}</span>
              </li>
            ))}
          </ul>
          <span class="mock-accept">{t('home.mock.accept')}</span>
        </div>
        <span class="mock-chip one"><Fragment set:html={svg('<path d="M20 6 9 17l-5-5" />')} />{t('home.og.kicker')}</span>
        <span class="mock-chip two"><Fragment set:html={svg('<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />')} />{t('home.sellCards.2.title')}</span>
      </div>
    </div>
  </section>

  <section id="how-it-works" class="section" aria-labelledby="how-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="how-title">{t('home.howTitle')}</h2>
      </div>
      <ol class="step-grid">
        {raw<string[]>('home.steps').map((_, i) => (
          <li class="step-card">
            <span class="icon"><Fragment set:html={svg(stepIcons[i] ?? stepIcons[0])} /></span>
            <p set:html={rich(`home.steps.${i}`, { example: examples[0] })} />
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section-tint" aria-labelledby="ask-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="ask-title">{t('home.askTitle')}</h2>
      </div>
      <div class="ask-grid">
        {examples.map((r) => <p class="bubble">{r}</p>)}
      </div>
      {groups.length > 0 && (
        <>
          <h3 class="sub-head">{t('home.categories')}</h3>
          <ul class="chips">{groups.map((g) => <li><span lang={locale.segment ? 'en' : undefined}>{g}</span></li>)}</ul>
        </>
      )}
      {hubs.length > 0 && (
        <>
          <h3 class="sub-head">{t('home.pricesTitle')}</h3>
          <p class="muted">{t('home.pricesNote')}</p>
          <ul class="chips">{hubs.map((h) => <li><a href={`/quotes/${h.city.slug}`}>{h.city.name}</a></li>)}</ul>
        </>
      )}
    </div>
  </section>

  <section class="section band" aria-labelledby="sell-title">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">{t('sellers.og.kicker')}</p>
        <h2 id="sell-title">{t('home.sellTitle')}</h2>
        <p>{t('sellers.lead')}</p>
      </div>
      <div class="feature-grid">
        {raw<{ title: string }[]>('home.sellCards').map((_, i) => (
          <div class="feature">
            <span class="icon"><Fragment set:html={svg(sellIcons[i] ?? sellIcons[0])} /></span>
            <h3>{t(`home.sellCards.${i}.title`)}</h3>
            <p>{t(`home.sellCards.${i}.text`)}</p>
          </div>
        ))}
      </div>
      <div class="actions"><a class="btn" href={href('/sellers')}>{t('home.sellCta')} <Fragment set:html={svg('<path d="M5 12h14M13 5l7 7-7 7" />')} /></a></div>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="wrap">
      <div class="trust">
        <span class="icon"><Fragment set:html={svg('<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /><path d="m9 12 2 2 4-4" />')} /></span>
        <div>
          <h2>{t('home.dataTitle')}</h2>
          <p set:html={rich('home.dataText')} />
        </div>
      </div>

      <div class="section-head">
        <h2 id="faq-title">{t('home.faqTitle')}</h2>
      </div>
      <div class="faq">
        {faq.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section-end" aria-labelledby="cta-title">
    <div class="wrap">
      <div class="cta-band band">
        <h2 id="cta-title">{t('layout.ogCta')}</h2>
        <p class="muted">{t('home.og.detail')}</p>
        <StoreBadges campaign={locale.segment ? `home_cta_${locale.segment}` : 'home_cta'} locale={locale} />
        <a href={href('/sellers')}>{t('layout.becomeSeller')}</a>
      </div>
    </div>
  </section>
</Base>
