# Copy to .env for local builds. Everything here is PUBLIC (ends up in HTML or
# /.well-known files). Never put secrets in this site: the Turnstile SECRET key
# lives only in the Supabase Edge Function's secrets.

# Required: which app this build is for.
SITE_COUNTRY=usa
# Defaults to https://iwantusa.app or https://iwantindia.app (placeholder domains).
SITE_URL=

# Android App Links (/.well-known/assetlinks.json)
ANDROID_PACKAGE=                 # default com.calecute.iwant.<country>
ANDROID_EXTRA_PACKAGES=          # e.g. com.calecute.iwant.usa.stg for staging builds
ANDROID_SHA256_FINGERPRINTS=     # comma-separated AA:BB:... (Play App Signing key + upload key)

# iOS Universal Links (/.well-known/apple-app-site-association)
APPLE_TEAM_ID=                   # 10 characters
IOS_BUNDLE_ID=                   # default com.calecute.iwant.<country>
IOS_EXTRA_BUNDLE_IDS=
APPLE_APP_ID=                    # numeric App Store id; enables Smart App Banner + store badge

# Store links (badges say "Coming soon" and point to /waitlist until these are live)
PLAY_STORE_LIVE=0
PLAY_STORE_URL=
APP_STORE_URL=

# Forms (seller signup, contact, waitlist, account deletion)
PUBLIC_TURNSTILE_SITE_KEY=       # Cloudflare Turnstile SITE key (public)
FORMS_ENDPOINT=                  # https://<project-ref>.supabase.co/functions/v1/web-forms
SUPPORT_EMAIL=

# SEO price pages + buying guides (nightly seo-export Edge Function)
SEO_DATA_URL=                    # https://<ref>.supabase.co/storage/v1/object/public/public-data/seo/<country>.json
SEO_DATA_FILE=                   # local override, e.g. data/seo/fixtures/usa.json
SEO_DATA_REQUIRED=0              # 1 = fail the build if SEO_DATA_URL cannot be fetched (set 1 on Production)

# 1 = fail the build while legal pages still contain {{PLACEHOLDERS}} (use in production)
LEGAL_STRICT=0

# Town pages (lib/towns.ts, lib/trends.ts; see web/README.md)
TOWNS_LIMIT=                     # build only the curated towns + the N largest others (quick local builds)
TRENDS_DATA_URL=                 # trends pipeline bucket; town pages' "What's happening" (optional)
TRENDS_SITE_URL=                 # default https://iwant-trends-web.vercel.app (links only)
TRENDS_DATA_DIR=                 # default ../trends_site/data/articles
TRENDS_INCLUDE_FIXTURES=0        # 1 = also show fixture articles (local testing with TRENDS_DATA_DIR=../trends_site/data/fixtures)
# Community feed page (/community): reads public requests, comments and group buys through
# read-only RPCs. Both values are PUBLIC (the anon / publishable key). Unset = "coming soon" page.
PUBLIC_SUPABASE_URL=             # https://<project-ref>.supabase.co
PUBLIC_SUPABASE_ANON_KEY=
REQUESTS_FEED_URL=               # https base URL of per-town recent-request JSON (<url>/<state>/<town>.json); unset = no section
