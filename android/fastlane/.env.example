# Copy to android/fastlane/.env (git-ignored) or set in CI secrets. Never commit real values.
# Every variable can be set per country with a _USA / _INDIA suffix; the unsuffixed
# name is used as a fallback. Full reference: fastlane/README.md

# --- Google Play service account (one per Play developer account / legal entity) ---
# Path to the JSON key (relative to the repo root or absolute), or the raw JSON (CI).
PLAY_JSON_KEY_PATH_USA=secrets/play-service-account-usa.json
PLAY_JSON_KEY_PATH_INDIA=secrets/play-service-account-india.json
# PLAY_JSON_KEY_DATA_USA=
# PLAY_JSON_KEY_DATA_INDIA=

# --- Upload keystore (copied to ANDROID_KEYSTORE_PATH etc. for Gradle at build time) ---
ANDROID_KEYSTORE_PATH_USA=secrets/upload-usa.jks
ANDROID_KEYSTORE_PASSWORD_USA=
ANDROID_KEY_ALIAS_USA=upload
ANDROID_KEY_PASSWORD_USA=
ANDROID_KEYSTORE_PATH_INDIA=secrets/upload-india.jks
ANDROID_KEYSTORE_PASSWORD_INDIA=
ANDROID_KEY_ALIAS_INDIA=upload
ANDROID_KEY_PASSWORD_INDIA=

# --- Google Maps Android key (copied to MAPS_API_KEY_ANDROID for Gradle) ---
MAPS_API_KEY_ANDROID_USA=
MAPS_API_KEY_ANDROID_INDIA=

# --- Play tracks ---
# PLAY_RELEASE_STATUS=draft        # use "draft" until each app's first release is reviewed
PLAY_CLOSED_TRACK=alpha            # closed testing track name (alpha = default "Closed testing")
PLAY_ROLLOUT=0.1                   # production staged rollout fraction

# --- Build ---
# Optional JSON of --dart-define values per country (Supabase URL + anon key, etc.)
# DART_DEFINE_FILE_USA=config/usa.prod.json
# DART_DEFINE_FILE_INDIA=config/india.prod.json

# --- Crashlytics Dart symbol upload (optional; needs the Firebase CLI) ---
# FIREBASE_ANDROID_APP_ID_USA=1:000000000000:android:0000000000000000
# FIREBASE_ANDROID_APP_ID_INDIA=1:000000000000:android:0000000000000000

# --- Store listing placeholders substituted into fastlane/metadata at upload time ---
WEB_DOMAIN_USA=
WEB_DOMAIN_INDIA=
